resource "aws_security_group" "redis" {
  name        = "${var.name}-redis-sg"
  description = "Redis - allow from backend only"
  vpc_id      = var.vpc_id

  ingress {
    from_port       = 6379
    to_port         = 6379
    protocol        = "tcp"
    security_groups = [aws_security_group.backend.id]
  }

  egress {
    from_port   = 0
